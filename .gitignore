# Secrets
.env

# Subagent-driven development scratch
.superpowers/

# Python
__pycache__/
*.pyc
.venv/

# Node / Remotion
node_modules/

# Project working data (heavy media, caches)
projects/*/work/
projects/*/output/

# Source footage and music — gigabytes of media, never in git
#
# `assets/*` rather than `assets/`, because git never looks inside an excluded
# DIRECTORY — so the negation below would have no effect at all under `assets/`.
assets/*
# The exception: the cartoon-effects sprite library is a few hundred kilobytes of
# committed pipeline input, not media. The effects stage may only offer what the
# manifest lists, so a clone without it would plan no effects at all.
!assets/effects/
# The same reasoning, and the same test: is a clone without this file able to
# produce the delivery this repository describes? The branded intro opens every
# finished video, `config.yaml` names it, and preflight refuses a delivery whose
# `polish.intro_clip` is missing — so a clone without it cannot. 5.7 MB, one
# file, and it changes about as often as the channel's name does.
!assets/artem-intro-opus.mp4

# macOS
.DS_Store

# Agent worktrees
.claude/worktrees/
