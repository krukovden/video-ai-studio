# Stock footage (free tiers) — already obtained, used by a later plan
PEXELS_API_KEY=
PIXABAY_API_KEY=

# The only metered thing in the pipeline: the one provider that can watch the
# footage rather than read a transcript of it. Get a key at
# https://aistudio.google.com/apikey, then point a stage at it in config.yaml:
#
#   llm_by_stage:
#     analyze: gemini_api
#
# Several models carry a free tier. The Gemini CLI's free individual tier does
# not work any more, and could not pass a video file to the model anyway.
GEMINI_API_KEY=

ASSEMBLYAI_API_KEY=
